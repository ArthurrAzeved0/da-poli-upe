// Cloudflare Pages project: static Astro build + Pages Functions (functions/) reading the shared D1.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "da-poli",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "da-poli",
      // Same database as apps/etl/wrangler.jsonc. Replace with the id printed by `wrangler d1 create da-poli`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../db/migrations"
    }
  ]
}
