/** The full statement with filters. Filters only change this list; the plate stays fixed. */
---

<section class="extrato" aria-labelledby="titulo-extrato" data-extrato>
  <div class="cabeca">
    <h2 id="titulo-extrato">Extrato completo</h2>
    <p class="contagem" data-contagem aria-live="polite"></p>
  </div>

  <form class="filtros" data-filtros role="search" aria-label="Filtrar o extrato">
    <label>
      <span>Mês</span>
      <select name="mes" data-filtro-mes><option value="">Todos</option></select>
    </label>
    <fieldset>
      <legend>Tipo</legend>
      <div class="segmentos">
        <label><input type="radio" name="tipo" value="" checked /><span>Tudo</span></label>
        <label><input type="radio" name="tipo" value="entrada" /><span>Entradas</span></label>
        <label><input type="radio" name="tipo" value="saida" /><span>Saídas</span></label>
      </div>
    </fieldset>
    <label>
      <span>Categoria</span>
      <select name="categoria" data-filtro-categoria><option value="">Todas</option></select>
    </label>
    <label class="busca">
      <span>Buscar</span>
      <input type="search" name="busca" placeholder="Descrição" autocomplete="off" />
    </label>
  </form>

  <table class="tabela">
    <caption class="so-leitor">Todas as movimentações do caixa do DA</caption>
    <thead>
      <tr>
        <th scope="col">Data</th>
        <th scope="col">Descrição</th>
        <th scope="col">Categoria</th>
        <th scope="col" class="num">Valor</th>
      </tr>
    </thead>
    <tbody data-linhas>
      <tr class="carregando"><td colspan="4">Carregando as movimentações…</td></tr>
    </tbody>
  </table>
  <p class="vazio" data-vazio hidden></p>
  <button type="button" class="mais" data-mostrar-mais hidden>Mostrar mais</button>
</section>

<style>
  .extrato {
    margin-top: var(--e-8);
    border-top: var(--regra) solid var(--magenta);
    padding-top: var(--e-5);
  }
  .cabeca { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--e-2) var(--e-6); }
  h2 { font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); color: var(--magenta); }
  .contagem { color: var(--tinta-2); font-weight: 500; }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--e-4) var(--e-5);
    margin: var(--e-5) 0 var(--e-4);
  }
  .filtros label, .filtros fieldset { display: flex; flex-direction: column; gap: var(--e-1); }
  .filtros fieldset { border: 0; margin: 0; padding: 0; }
  .filtros > label > span,
  .filtros legend {
    font: 700 0.9rem/1.2 var(--fonte-placa);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta-2);
    padding: 0;
  }
  .filtros legend { margin-bottom: var(--e-1); }
  select, input[type='search'] {
    height: 2.75rem;
    border: 2px solid var(--magenta);
    border-radius: 0;
    background: #fff;
    padding: 0 var(--e-3);
    min-width: 11rem;
  }
  select:hover, input[type='search']:hover { border-color: var(--vinho); }
  input[type='search']::placeholder { color: #8a5a6c; }
  .busca { flex: 1 1 14rem; }
  .busca input { width: 100%; }
  .filtros :is(select, input):focus-visible { outline-offset: 1px; }

  .segmentos { display: flex; border: 2px solid var(--magenta); height: 2.75rem; }
  .segmentos label { position: relative; flex-direction: row; }
  .segmentos input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .segmentos span {
    display: flex;
    align-items: center;
    padding: 0 var(--e-4);
    font-weight: 600;
    background: #fff;
    color: var(--magenta);
  }
  .segmentos label + label span { border-left: 2px solid var(--magenta); }
  .segmentos input:hover + span { background: var(--chao-forte); }
  .segmentos input:checked + span { background: var(--magenta); color: #fff; }
  .segmentos input:focus-visible + span { outline: 3px solid var(--vinho); outline-offset: 2px; position: relative; z-index: 1; }

  .tabela { width: 100%; border-collapse: collapse; }
  .tabela th {
    text-align: left;
    font: 700 0.9rem/1.2 var(--fonte-placa);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta-2);
    padding: var(--e-3) var(--e-4) var(--e-3) 0;
    border-bottom: var(--regra) solid var(--magenta);
  }
  .tabela td {
    padding: var(--e-3) var(--e-4) var(--e-3) 0;
    border-bottom: 2px solid var(--chao-forte);
    vertical-align: baseline;
  }
  .tabela :is(th, td).num { text-align: right; padding-right: 0; }
  .tabela :global(td.data) { white-space: nowrap; color: var(--tinta-2); width: 7.5rem; }
  .tabela :global(td.cat) { color: var(--tinta-2); width: 12rem; }
  .tabela :global(td.num) { font: 700 1.25rem/1 var(--fonte-placa); white-space: nowrap; width: 10rem; }
  .tabela :global(.saida td.num) { color: var(--framboesa); }
  .tabela :global(.nota) { display: block; font-size: 0.92rem; color: var(--tinta-2); margin-top: var(--e-1); }
  .tabela :global(.estornada :is(.desc-texto, td.num, td.data, td.cat)) {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--tinta-2);
    color: var(--tinta-2);
  }
  .tabela :global(tr:target) { background: var(--chao-forte); }
  .tabela :global(tr:target td) { border-bottom-color: var(--magenta); }
  .carregando td, .vazio { color: var(--tinta-2); padding-block: var(--e-5); }
  .vazio[hidden], .mais[hidden] { display: none; }
  .mais {
    margin-top: var(--e-5);
    min-height: 2.75rem;
    padding: 0 var(--e-5);
    background: #fff;
    color: var(--magenta);
    border: 2px solid var(--magenta);
    font-weight: 600;
    cursor: pointer;
  }
  .mais:hover { background: var(--magenta); color: #fff; }

  @media (max-width: 45rem) {
    .tabela thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .tabela :global(tr) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'desc num' 'meta meta';
      gap: var(--e-1) var(--e-4);
      padding: var(--e-3) 0;
      border-bottom: 2px solid var(--chao-forte);
    }
    .tabela :global(td) { border: 0; padding: 0; width: auto !important; }
    .tabela :global(td.desc) { grid-area: desc; }
    .tabela :global(td.num) { grid-area: num; }
    .tabela :global(td.data) { grid-area: meta; font-size: 0.92rem; }
    .tabela :global(td.cat) { grid-area: meta; justify-self: end; font-size: 0.92rem; }
    .carregando :global(td) { grid-column: 1 / -1; }
    select { min-width: 0; width: 100%; }
    .filtros > label:not(.busca) { flex: 1 1 9rem; }
    .filtros fieldset { flex: 1 1 100%; }
    .segmentos label { flex: 1; }
    .segmentos span { justify-content: center; width: 100%; }
    .mais { width: 100%; }
  }
</style>
