// Worker that reconciles the Google Sheet with the D1 ledger on a schedule.
// Secrets (set with `wrangler secret put <NOME>`; locally in .dev.vars):
//   GOOGLE_SERVICE_ACCOUNT  full JSON key of the Google service account
//   TELEGRAM_BOT_TOKEN      bot token from @BotFather
//   TELEGRAM_CHAT_ID        chat (group) of the DA board
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "da-poli-etl",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Not reachable from the internet: it only runs on the cron below.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    // ID from the spreadsheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
    "SHEET_ID": "",
    "SHEET_ABA": "Transações"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "da-poli",
      // D1 "da-poli" in the DA account (region ENAM).
      "database_id": "71f7c2f0-6826-49e7-9e8b-44a144a8029a",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
